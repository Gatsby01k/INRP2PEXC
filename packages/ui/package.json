{
  "name": "@inrp2p/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format/index.ts",
    "./tokens": "./src/tokens/tokens.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "UPDATE_VISUALS=1 playwright test -c visual/playwright.config.ts",
    "visual:docker": "bash visual/docker.sh compare",
    "visual:docker:update": "bash visual/docker.sh update",
    "tokens:generate": "node scripts/generate-tokens.ts"
  },
  "dependencies": {
    "@inrp2p/kernel": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
