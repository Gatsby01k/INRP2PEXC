{
  "name": "inrp2p-exchange",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.ts",
    "secret-scan": "node scripts/secret-scan.ts",
    "versions:check": "node scripts/check-versions.ts",
    "workspace:graph": "node scripts/workspace-graph.ts",
    "smoke:tron": "node scripts/tron-smoke.ts",
    "load:test": "LOAD_WORKERS=${LOAD_WORKERS:-12} LOAD_TRADES_PER_WORKER=${LOAD_TRADES_PER_WORKER:-25} vitest run --project integration packages/settlement/test/load.int.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inrp2p/adapters": "workspace:*",
    "@inrp2p/audit": "workspace:*",
    "@inrp2p/commands": "workspace:*",
    "@inrp2p/db": "workspace:*",
    "@inrp2p/identity": "workspace:*",
    "@inrp2p/kernel": "workspace:*",
    "@inrp2p/ledger": "workspace:*",
    "@inrp2p/outbox": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
