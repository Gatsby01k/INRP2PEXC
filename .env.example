# Web (apps/web)
DATABASE_URL=postgres://inrp2p_app_login:change-me@localhost:5432/inrp2p
DESK_HOST=desk.inrp2p.com
APP_HOST=app.inrp2p.com
PUBLIC_HOST=inrp2p.com
OPERATOR_AUTH_SECRET=generate-32-random-bytes-hex
CLIENT_AUTH_SECRET=generate-a-different-32-random-bytes-hex

# Worker (apps/worker)
WORKER_DATABASE_URL=postgres://inrp2p_worker_login:change-me@localhost:5432/inrp2p

# Migrations (packages/db, run as the schema owner; must be a member of inrp2p_worker for queue upgrades)
DATABASE_MIGRATOR_URL=postgres://inrp2p_migrator:change-me@localhost:5432/inrp2p

# Tests: omit to use Testcontainers postgres:18.6; set to an existing PostgreSQL superuser URL otherwise
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# REQUIRE_PG_VERSION=18.6

# Field protection (web and worker; SECURITY §5, RUNBOOKS field-encryption-keys). Production: aws-kms only.
INRP2P_ENV=development
INRP2P_KEK_PROVIDER=local
INRP2P_KEK_ID=dev-kek
# local provider only (never production): 32 random bytes, base64
INRP2P_KEK_BASE64=
# aws-kms provider: the key ARN (not an alias); credentials come from the workload role
# INRP2P_KMS_KEY_ARN=arn:aws:kms:<region>:<account>:key/<id>
# INRP2P_KMS_ENDPOINT=
# Earlier keys that still open old values: [{"id":"…","provider":"aws-kms","arn":"…"}]
# INRP2P_KEK_PREVIOUS=
# 32 random bytes, base64, from the secret manager
INRP2P_FIELD_HMAC_BASE64=

