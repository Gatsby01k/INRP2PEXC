# Web (apps/web)
DATABASE_URL=postgres://inrp2p_app_login:change-me@localhost:5432/inrp2p
DESK_HOST=desk.inrp2p.com
APP_HOST=app.inrp2p.com
PUBLIC_HOST=inrp2p.com
OPERATOR_AUTH_SECRET=generate-32-random-bytes-hex
CLIENT_AUTH_SECRET=generate-a-different-32-random-bytes-hex

# Worker (apps/worker)
WORKER_DATABASE_URL=postgres://inrp2p_worker_login:change-me@localhost:5432/inrp2p

# Migrations (packages/db, run as the schema owner; must be a member of inrp2p_worker for queue upgrades)
DATABASE_MIGRATOR_URL=postgres://inrp2p_migrator:change-me@localhost:5432/inrp2p

# Tests: omit to use Testcontainers postgres:18.6; set to an existing PostgreSQL superuser URL otherwise
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# REQUIRE_PG_VERSION=18.6

# Field protection (web and worker; SECURITY §5, RUNBOOKS field-encryption-keys). Production: aws-kms only.
INRP2P_ENV=development
INRP2P_KEK_PROVIDER=local
INRP2P_KEK_ID=dev-kek
# local provider only (never production): 32 random bytes, base64
INRP2P_KEK_BASE64=
# aws-kms provider: the key ARN (not an alias); credentials come from the workload role
# INRP2P_KMS_KEY_ARN=arn:aws:kms:<region>:<account>:key/<id>
# INRP2P_KMS_ENDPOINT=
# Earlier keys that still open old values: [{"id":"…","provider":"aws-kms","arn":"…"}]
# INRP2P_KEK_PREVIOUS=
# 32 random bytes, base64, from the secret manager
INRP2P_FIELD_HMAC_BASE64=

# Email (web: client sign-in codes; worker: acceptance codes and client notifications — TD-04, RUNBOOKS email-delivery).
# Unset: sign-in and acceptance codes fail loudly and client notifications stay in-app only. The from address must be on a
# domain verified with Resend. The key comes from the secret manager, never from a file in the image.
# RESEND_API_KEY=
# RESEND_FROM=INRP2P Exchange <no-reply@inrp2p.com>
# RESEND_BASE_URL=https://api.resend.com
# Development and end-to-end runs only (refused when INRP2P_ENV=production): client sign-in codes appended to a file.
# INRP2P_CLIENT_OTP_SINK_FILE=

# Private object storage (S3 API: AWS S3 or a compatible store). Credentials come from the workload role or the AWS_*
# environment, never from a file. Buckets are private, versioned, and created with Object Lock (RUNBOOKS receipt-integrity).
# INRP2P_OBJECT_STORE_REGION=ap-south-1
# INRP2P_OBJECT_STORE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# Receipts written once at issue (TD-12). Unset: receipts are regenerated from their snapshot and checked by hash.
# INRP2P_RECEIPTS_BUCKET=
# Object Lock retention for stored receipts, in days — a period only the owner can set (record-keeping obligations).
# INRP2P_RECEIPT_RETENTION_DAYS=
# Daily export of audit seals, under Object Lock in compliance mode (TD-17).
# INRP2P_AUDIT_SEAL_BUCKET=
# INRP2P_AUDIT_SEAL_RETENTION_DAYS=
# PDF receipts need a browser in the image that prints them (web on request, worker at issue).
# INRP2P_PDF_RENDERER=chromium
# INRP2P_CHROMIUM_PATH=
